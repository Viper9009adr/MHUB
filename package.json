{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "meridian-hub",
  "description": "Minimal AGENTIC-CLI Phase 1 slice",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "typecheck": "npx tsc --noEmit",
    "typecheck:tui": "npx tsc --noEmit --project reconstructed/tsconfig.tui.json",
    "build:tui": "cd reconstructed && npx vite build",
    "dev:tui": "cd reconstructed && npx vite",
    "lint": "npx eslint reconstructed/src/",
    "test:m1": "bun test tests/m1_dispatch_non_dev_hard_fail.test.ts",
    "test:m2": "bun test tests/m2_refcount_lock.test.ts",
    "test:m3": "bun test tests/m3_hal_orc_pubsub.test.ts",
    "test:m4": "bun test tests/m4_hard_overflow_sequence.test.ts",
    "test:m5": "bun test tests/m5_critical_api_schema.test.ts",
    "test:m6": "bun test tests/m6_ci_hooks_foundation.test.ts",
    "test:m7": "bun test tests/m7_proto_contracts.test.ts",
    "test:m8": "bun test tests/m8_replay_cursor.test.ts",
    "test:m9": "bun test tests/m9_overflow_route_knobs.test.ts",
    "test:m10": "bun test tests/m10_openapi_sdk_contract.test.ts",
    "test:m11": "bun test tests/m11_overflow_chaos_contract.test.ts",
    "test:m12": "bun test tests/m12_hub_pubsub_debounce_drop.contract.test.ts",
    "test:critical": "bun test tests/m1_dispatch_non_dev_hard_fail.test.ts tests/m2_refcount_lock.test.ts tests/m3_hal_orc_pubsub.test.ts tests/m4_hard_overflow_sequence.test.ts tests/m5_critical_api_schema.test.ts tests/m6_ci_hooks_foundation.test.ts tests/m7_proto_contracts.test.ts tests/m8_replay_cursor.test.ts tests/m9_overflow_route_knobs.test.ts tests/m10_openapi_sdk_contract.test.ts tests/m11_overflow_chaos_contract.test.ts tests/m12_hub_pubsub_debounce_drop.contract.test.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/react": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "typescript": "^5.8.2",
    "vite": "^5.4.0",
    "zod": "^3.23.8"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "chalk": "^5.3.0",
    "figures": "^6.1.0",
    "ink": "^5.0.1",
    "react": "^18.3.0"
  }
}
