# Meridian HUB — Environment Configuration
# Copy to .env and fill in values.

# =============================================================================
# Backend
# =============================================================================

# Use null (in-memory) storage backend instead of PostgreSQL
# Values: true | false
MERIDIAN_NULL_BACKEND=true

# Enable persistent storage via PostgreSQL
# Values: true | false
STORAGE_ENABLED=false

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meridian

# =============================================================================
# gRPC
# =============================================================================

# gRPC server port (default: 50052, avoids conflict with 50051)
MERIDIAN_GRPC_PORT=50052

# =============================================================================
# HTTP API
# =============================================================================

# HTTP API server port (default: 8123)
API_PORT=8123

# =============================================================================
# Redis
# =============================================================================

# Enable Redis pub/sub for ORC↔HAL communication
# Values: true | false
REDIS_ENABLED=false

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# LLM Providers
# =============================================================================

# Default LLM provider (openai, anthropic, nvidia, openrouter)
LLM_PROVIDER=openai

# Default model identifier
LLM_MODEL=gpt-4o

# API keys — set at least one for your chosen provider
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
NVIDIA_API_KEY=nvapi-...
OPENROUTER_API_KEY=sk-or-...

# =============================================================================
# Orchestration
# =============================================================================

# Number of ARC↔CRT debate rounds before ORC delivers final response.
# Each round: CRT reviews ARC's plan, ARC revises if rejected.
# Loop exits early when CRT returns APPROVED.
# Set to 1 to disable debate (single pass). Set to 0 to use default (3).
MERIDIAN_DEBATE_ROUNDS=3

# =============================================================================
# TUI
# =============================================================================

# Backend API URL for the TUI
MERIDIAN_API_URL=http://localhost:8123
